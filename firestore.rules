rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }
    match /kingdoms/{kingdomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;
    }
    match /allianceRequests/{requestId} {
      allow read: if request.auth != null && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid && request.resource.data.toUid != request.auth.uid && request.resource.data.status == 'pending';
      allow update: if request.auth != null && resource.data.toUid == request.auth.uid && request.resource.data.fromUid == resource.data.fromUid && request.resource.data.toUid == resource.data.toUid;
      allow delete: if false;
    }
    match /worldEvents/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
